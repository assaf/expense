// Expense schema — single source of truth for the Postgres database.
// Managed with `pnpm db:push` (dev/deploy) and versioned migrations
// (prisma/migrations). See app/lib/database.ts for the store layer.

generator client {
  provider               = "prisma-client"
  output                 = "generated"
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

/// A shared workspace: users in the same account share all data below.
model Account {
  id         String     @id
  name       String     @unique
  inviteCode String     @unique
  createdAt  String

  users         User[]
  expenses      Expense[]
  reports       Report[]
  categories    Category[]
  mileage       Mileage[]
  settings      Settings[]
  imageBlobs    ImageBlob[]
  inboundEmails InboundEmail[]
  inboundSenders InboundSender[]
  apiTokens     ApiToken[]

  @@map("accounts")
}

/// A login identity, always linked to exactly one account.
/// The email is the login name (stored lowercase) — unique per user, and
/// format-validated at signup/join.
model User {
  id           String  @id
  accountId    String
  email        String  @unique
  passwordHash String
  createdAt    String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Expense {
  id           String @id
  type         String
  date         String
  report       String
  category     String
  description  String
  amount       Decimal? @db.Decimal(10, 2)
  merchant     String
  imageFile    String
  imageMime    String
  originalName String
  distanceMiles Decimal? @db.Decimal(10, 2)
  locations    Json
  /// Driving-route geometry ({ coords, returnCoords } as [lat, lng] pairs)
  /// persisted so the map shows the routed trip everywhere — the list
  /// thumbnails and the editor on open — not just after a recompute.
  route        Json?
  createdAt    String
  updatedAt    String
  accountId    String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model Report {
  id        BigInt @id @default(autoincrement())
  name      String
  accountId String
  closed    Boolean @default(false)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@map("reports")
}

model Category {
  id        BigInt @id @default(autoincrement())
  name      String
  accountId String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@map("categories")
}

/// Derived artifact rebuilt on every expense write (mirrors the old mileage.csv).
model Mileage {
  id           BigInt @id @default(autoincrement())
  date         String
  report       String
  locations    String
  distanceMiles Decimal? @db.Decimal(10, 2)
  accountId    String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("mileage")
}

/// Per-account key/value settings (home location, mileage rates).
model Settings {
  accountId String
  key       String
  value     String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, key])
  @@map("settings")
}

/// Receipt image bytes — all images live in Postgres (no external store).
/// Keys are namespaced per account (`images/{accountId}/…`) so the same
/// filename in two accounts never collides.
model ImageBlob {
  accountId String
  key       String
  mime      String
  data      Bytes

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, key])
  @@map("image_blobs")
}

/// Idempotency + audit record for emails received via the inbound webhook.
/// One row per email_id; status tracks processing so Resend retries never
/// create duplicate expenses.
model InboundEmail {
  emailId   String @id
  accountId String
  subject   String
  status    String // processing | created | partial | error
  error     String
  createdAt String
  updatedAt String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("inbound_emails")
}

/// One allowed receipt-forwarding sender per account. When the same address
/// is allowed by several accounts, the row with the earliest createdAt wins
/// ("first added takes precedence"); removing it falls through to the next.
model InboundSender {
  accountId String
  address   String // normalized lowercase
  createdAt String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, address])
  @@index([address])
  @@map("inbound_senders")
}

/// A machine token for the MCP/API endpoint (bearer auth). The raw token is
/// shown once at creation — only its SHA-256 hash is stored. Read-only
/// tokens can query expenses but never create or change anything.
model ApiToken {
  id         String   @id
  accountId  String
  name       String
  tokenHash  String   @unique
  readOnly   Boolean  @default(false)
  createdAt  String
  lastUsedAt String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("api_tokens")
}
