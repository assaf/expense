// Expense schema — single source of truth for the Postgres database.
// Managed with `pnpm db:push` (dev/deploy) and versioned migrations
// (prisma/migrations). See app/lib/database.ts for the store layer.

generator client {
  provider               = "prisma-client"
  output                 = "generated"
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

/// A shared workspace: users in the same account share all data below.
model Account {
  id         String     @id
  name       String     @unique
  inviteCode String     @unique
  createdAt  String

  users         User[]
  expenses      Expense[]
  reports       Report[]
  categories    Category[]
  settings      Settings[]
  imageBlobs    ImageBlob[]
  duplicateDismissals DuplicateDismissal[]
  inboundEmails InboundEmail[]
  inboundSenders InboundSender[]
  inboundSenderVerifications InboundSenderVerification[]

  @@map("accounts")
}

/// A login identity, always linked to exactly one account.
/// The email is the login name (stored lowercase) — unique per user, and
/// format-validated at signup/join.
model User {
  id           String  @id
  accountId    String
  email        String  @unique
  passwordHash String
  /// When the emailed verification link was clicked — null means the
  /// account can't sign in until the email is verified. Legacy rows (created
  /// before email verification was required) were backfilled at migration.
  emailVerifiedAt       String?
  /// sha256 of the current verification token in the emailed link.
  verificationTokenHash String?
  verificationSentAt    String?
  createdAt             String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Expense {
  id           String @id
  type         String
  date         String
  report       String
  category     String
  description  String
  amount       Decimal? @db.Decimal(10, 2)
  merchant     String
  imageFile    String
  imageMime    String
  originalName String
  distanceMiles Decimal? @db.Decimal(10, 2)
  /// IRS reimbursement type for mileage expenses: business | charity |
  /// medical | moving. Determines the rate (with the date) from the global
  /// mileage_rates master table. Ignored for receipt rows.
  mileageType  String @default("business")
  locations    Json
  /// Driving-route geometry ({ coords, returnCoords } as [lat, lng] pairs)
  /// persisted so the map shows the routed trip everywhere — the list
  /// thumbnails and the editor on open — not just after a recompute.
  route        Json?
  createdAt    String
  updatedAt    String
  accountId    String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Dismissed duplicate pairs this expense participates in (either side).
  dismissedAsA DuplicateDismissal[] @relation("duplicateDismissalsA")
  dismissedAsB DuplicateDismissal[] @relation("duplicateDismissalsB")

  @@map("expenses")
}

/// Expense pairs the user marked "not a duplicate" — one row per pair,
/// stored ordered (expenseAId < expenseBId) so a dismissal matches either
/// direction. The duplicate warning never shows for a dismissed pair again.
/// Cascade deletes keep the table tidy: a row dies with either expense or
/// with the account, so dismissals never linger for deleted rows.
model DuplicateDismissal {
  id         String @id
  expenseAId String
  expenseBId String
  accountId  String

  expenseA Expense @relation("duplicateDismissalsA", fields: [expenseAId], references: [id], onDelete: Cascade)
  expenseB Expense @relation("duplicateDismissalsB", fields: [expenseBId], references: [id], onDelete: Cascade)
  account  Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, expenseAId, expenseBId])
  @@map("duplicate_dismissals")
}

model Report {
  id        BigInt @id @default(autoincrement())
  name      String
  accountId String
  closed    Boolean @default(false)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@map("reports")
}

model Category {
  id        BigInt @id @default(autoincrement())
  name      String
  accountId String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@map("categories")
}

/// IRS standard mileage reimbursement rates — the master table. Global
/// (not per-account): the same IRS rates apply to everyone. One row per
/// (type, period); the period is an inclusive date range and the rate is
/// dollars per mile (half-cent rates like 23.5¢ store as 0.235). Synced
/// from app/data/mileage-rates.ts by initStore — edit the seed file to
/// update rates, no per-account overrides.
model MileageRate {
  id        BigInt  @id @default(autoincrement())
  type      String // business | charity | medical | moving
  startDate String // YYYY-MM-DD, inclusive
  endDate   String // YYYY-MM-DD, inclusive; "" = open-ended
  rate      Decimal @db.Decimal(5, 3)
  createdAt String

  @@index([type, startDate])
  @@map("mileage_rates")
}

/// Per-account key/value settings (home location).
model Settings {
  accountId String
  key       String
  value     String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, key])
  @@map("settings")
}

/// Receipt image bytes — all images live in Postgres (no external store).
/// Keys are namespaced per account (`images/{accountId}/…`) so the same
/// filename in two accounts never collides.
model ImageBlob {
  accountId String
  key       String
  mime      String
  data      Bytes

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, key])
  @@map("image_blobs")
}

/// Idempotency + audit record for emails received via the inbound webhook.
/// One row per email_id; status tracks processing so Resend retries never
/// create duplicate expenses.
model InboundEmail {
  emailId   String @id
  accountId String
  subject   String
  status    String // processing | created | partial | error
  error     String
  createdAt String
  updatedAt String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("inbound_emails")
}

/// One receipt-forwarding sender per account. Anyone may add an address
/// ("pending"), but it only accepts receipts once verified by clicking a
/// link emailed to that address — see InboundSenderVerification, the
/// single source of verified status. A pending row carries the token for
/// the one outstanding verification email (single-use, replaced on resend).
/// The account's login emails are auto-added as senders (see
/// ensureInboundSenderForUser) — a sign-in email is always a sender.
model InboundSender {
  accountId            String
  address              String // normalized lowercase
  verificationTokenHash String? // sha256 of the token in the emailed link
  verificationSentAt   String?
  createdAt            String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, address])
  @@index([address])
  @@map("inbound_senders")
}

/// Exclusivity authority for verified receipt-forwarding addresses: at most
/// one account can verify a given address (address is the primary key, so
/// the database rejects a second verified claim). The row is created when
/// the mailbox owner clicks the emailed verification link; creating it also
/// deletes every other account's pending rows for that address. Removing the
/// sender (Settings) deletes this row and frees the address again.
model InboundSenderVerification {
  address    String @id // normalized lowercase
  accountId  String
  verifiedAt String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("inbound_sender_verifications")
}

/// An OAuth 2.1 client registered by an MCP client via dynamic registration
/// (RFC 7591). Global across accounts — each user approves it for themselves.
model OAuthClient {
  id          String   @id // client_id
  secretHash  String?  @unique // client_secret, confidential clients only
  name        String
  redirectUris String  // JSON array of allowed redirect URIs
  authMethod  String // "none" | "client_secret_basic"
  createdAt   String

  codes    OAuthCode[]
  tokens   OAuthToken[]
  consents OAuthConsent[]

  @@map("oauth_clients")
}

/// Per-user approval of an OAuth client ("allow this app to access my
/// expenses"). Presence = consent was granted; deleting it revokes.
model OAuthConsent {
  userId    String
  clientId  String
  grantedAt String

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@map("oauth_consents")
}

/// One-time authorization codes: PKCE challenge bound, 10-minute TTL,
/// single use. `used` is claimed atomically so a code can't be replayed.
model OAuthCode {
  id          String   @id // sha256 of the raw code
  userId      String
  clientId    String
  challenge   String // S256 PKCE challenge (base64url of sha256(verifier))
  redirectUri String
  expiresAt   String
  used        Boolean  @default(false)
  createdAt   String

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("oauth_codes")
}

/// Opaque access + refresh tokens for OAuth-authenticated MCP clients,
/// hashed at rest. Access: 1h TTL; refresh: 30d, rotated on every grant.
model OAuthToken {
  tokenHash String   @id // sha256 of the raw token
  userId    String
  clientId  String
  type      String // "access" | "refresh"
  scope     String // "" — no scopes defined yet
  expiresAt String
  revokedAt String?
  createdAt String

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_tokens")
}
