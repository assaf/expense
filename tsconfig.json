{
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/**/*.ts",
    ".react-router/types/**/*",
    "prisma/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["build", "node_modules", "public"],
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2025", "ESNext.TypedArrays"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "~/*": ["./app/*"],
      "~/test/*": ["./test/*"],
      "+types/*": ["./.react-router/types/*"]
    },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "@react-router/node"],
    "verbatimModuleSyntax": true
  }
}
