#!/usr/bin/env bash
# Recreate the throwaway test database (expense_test) from the Prisma 8
# contract: drop the public schema, then `prisma db init` creates every
# table/index/FK additively and signs the marker. Replaces the v7
# `prisma db push --force-reset` flow.

set -eo pipefail

TEST_DB_URL="postgres://assaf@localhost/expense_test"

psql "$TEST_DB_URL" -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'
# Both variables, because prisma.config.ts prefers DATABASE_URL_UNPOOLED:
# overriding only DATABASE_URL lets a stray DATABASE_URL_UNPOOLED in the
# environment point this throwaway reset at another database. A leaked
# production URL once planned it against prod, where the plan wanted to
# disable row-level security (a "widening" operation) and was refused only
# by the migration policy.
DATABASE_URL="$TEST_DB_URL" DATABASE_URL_UNPOOLED="$TEST_DB_URL" pnpm exec prisma db init --quiet
