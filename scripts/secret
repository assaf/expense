#!/usr/bin/env bash
# Print the value of a secret, from the first source that holds a REAL one:
#   1. the environment (CI passes GitHub secrets this way)
#   2. ./.env, the local env file, which is where the real secrets live
#
# A pulled .env.prod is NOT a source: `vercel env pull` redacts sensitive vars
# as the literal string [SENSITIVE], so a value that came from there is not a
# value. That is how the local deploy path came to smoke with the
# placeholder: the route rejected it and answered a 404 that read like a
# broken deployment (2026-10-20). The same trap applies to any script that
# sources a pulled env file.
#
# Usage: ./scripts/secret <NAME>
# Exits 1, with a message, when no source has a usable value.
set -eo pipefail

NAME="${1:-}"
case "$NAME" in
  "" | [!A-Za-z_]* | *[!A-Za-z0-9_]*)
    echo "usage: $0 <SECRET_NAME>" >&2
    exit 1
    ;;
esac

# The env file is looked up in the current directory, next to the pulled
# .env.prod that scripts/deploy writes and sources.
ENV_FILE="${ENV_FILE:-./.env}"
REDACTED="[SENSITIVE]"

usable() {
  [ -n "$1" ] && [ "$1" != "$REDACTED" ]
}

# The environment first: CI sets it from GitHub secrets, and an operator can
# export a value to override the file.
VALUE=$(printenv "$NAME" 2>/dev/null || true)
if usable "$VALUE"; then
  printf '%s' "$VALUE"
  exit 0
fi

# Then the local env file. Read the one key; do not source the file.
if [ -f "$ENV_FILE" ]; then
  FILE_VALUE=$(awk -v key="$NAME" '
    index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }
  ' "$ENV_FILE")
  case "$FILE_VALUE" in
    \"*\") FILE_VALUE="${FILE_VALUE#\"}"; FILE_VALUE="${FILE_VALUE%\"}" ;;
    \'*\') FILE_VALUE="${FILE_VALUE#\'}"; FILE_VALUE="${FILE_VALUE%\'}" ;;
  esac
  if usable "$FILE_VALUE"; then
    printf '%s' "$FILE_VALUE"
    exit 0
  fi
fi

if [ -n "$VALUE" ]; then
  echo "${NAME} is the redaction placeholder ${REDACTED}, not a value, and ${ENV_FILE} has no real one." >&2
else
  echo "${NAME} is not set, and ${ENV_FILE} has no value for it." >&2
fi
exit 1
