#!/usr/bin/env bash
# Post-deploy smoke check: curl /api/smoke on a deployment and validate the
# PDF/OCR/MCP result. Shared by scripts/deploy (after CLI deploys) and the
# CI workflow's pdf-ocr-smoke job (.github/workflows/deployment-smoke.yml),
# so the two can never drift apart.
#
# Usage: ./scripts/smoke-check <deployment-url-or-host>
# Reads SMOKE_TEST_SECRET and VERCEL_PROTECTION_BYPASS from the environment
# (the bypass header is needed because deployment URLs are behind Vercel SSO
# protection). Exits 1 when the pipeline is broken.
set -eo pipefail

URL="${1:-}"
if [ -z "$URL" ]; then
  echo "usage: $0 <deployment-url-or-host>" >&2
  exit 1
fi
case "$URL" in
  http://* | https://*) ;;
  *) URL="https://${URL}" ;;
esac

RESPONSE=$(curl -sS --fail --retry 3 --retry-delay 5 --retry-connrefused --max-time 120 \
  -H "x-vercel-protection-bypass: ${VERCEL_PROTECTION_BYPASS}" \
  -H "x-smoke-secret: ${SMOKE_TEST_SECRET}" "${URL}/api/smoke") || {
  echo "Smoke check failed (network/HTTP). Check ${URL}/api/smoke manually." >&2
  exit 1
}
echo "$RESPONSE" | node -e '
  let body = "";
  process.stdin.on("data", (c) => (body += c));
  process.stdin.on("end", () => {
    const r = JSON.parse(body);
    if (r.ok !== true) {
      console.error("Smoke check failed:", r.error ?? JSON.stringify(r));
      process.exit(1);
    }
    console.log("PDF + OCR OK —", r.pdfText, "| OCR:", r.ocrText, "| MCP:", r.mcp ? r.mcp.tools + " tools" : "skipped", "(" + r.ms + "ms)");
  });
' || {
  echo "Smoke check failed: PDF/OCR/MCP pipeline did not pass on ${URL}." >&2
  exit 1
}
