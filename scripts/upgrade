#!/usr/bin/env bash
set -eo pipefail

echo -e "\033[32m  Upgrading pnpm …\033[0m"
pnpm self-update

echo -e "\033[32m  Upgrading dependencies …\033[0m"
pnpm update --latest

# The orm packages publish ahead of the CLI they have to match (2026-11-01:
# orm rc.22 was `latest` while prisma 8.0.0-rc.29 bundles rc.21), so
# `update --latest` installs a pair no CLI accepts: `prisma contract emit`
# then fails or emits a contract.d.ts the CLI cannot explain. The CLI decides
# the pin, so align it here rather than letting the bump commit an unusable
# tree.
echo -e "\033[32m  Aligning Prisma orm packages with the CLI …\033[0m"
node scripts/prisma-orm-pins.mjs --fix
# Install right away so the lockfile matches the corrected pins before the
# dedupe/prune pass reasons about them.
pnpm install

echo -e "\033[32m  Deduping dependencies …\033[0m"
pnpm dedupe --ignore-scripts
pnpm prune --ignore-scripts

echo -e "\033[32m  Installing from the updated lockfile …\033[0m"
pnpm install

echo -e "\033[32m  Installing Playwright browsers …\033[0m"
# Browsers must match the just-upgraded playwright package (pnpm exec, NOT
# pnpx: that fetches a fresh registry copy, not the lockfile version), and
# run after every dependency mutation so the final node_modules decides.
# The suite launches chromium (launchBrowser.ts, password-reset,
# email-render); webkit alone left it failing after version bumps.
pnpm exec playwright install chromium --with-deps

echo -e "\033[32m  Running tests …\033[0m"
# The committed baselines live in screenshots/, and the matcher removes its own
# *.new.png / *.diff.png artifacts, so there is nothing to reset here.
vpr check
vpr test

# The pin check lives in scripts/check, which the vpr commands above skip;
# run it explicitly so a registry that moved one side only can never be
# committed green (472e261 did exactly that).
node scripts/prisma-orm-pins.mjs

echo -e "\033[32m  Auditing dependencies …\033[0m"
AUDIT_FAILED=0
pnpm audit --prod || AUDIT_FAILED=1

echo -e "\033[32m  Cleaning up …\033[0m"
git gc --prune=now || echo

echo -e "\033[32m  Commit …\033[0m"
git add package.json pnpm-lock.yaml pnpm-workspace.yaml
omp commit

echo -e "\033[32m  Checking for outdated dependencies …\033[0m"
pnpm outdated

terminal-notifier -group "scripts.upgrade" -sound default  -title "$0" -message "Done!" -contentImage "public/logo-icon-512.png"

if [ "$AUDIT_FAILED" -ne 0 ]; then
  echo "pnpm audit reported vulnerabilities in production dependencies; the bump is committed, review them before deploying." >&2
  exit 1
fi
exit 0
