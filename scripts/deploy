#!/usr/bin/env bash
# Deploy expense to production:
#   1. check + tests (never migrate before the test suite passes)
#   2. sync the production database schema (scripts/migrate-prod — env pulled
#      from Vercel, prisma db push, migrate history)
#   3. deploy with the Vercel CLI
#   4. post-deploy smoke check (PDF + OCR + MCP, /api/smoke)
#   5. open the production site
#
# Prod secrets come from `vercel env pull`. Use DATABASE_URL_UNPOOLED for schema
# DDL — the pooled URL is for runtime queries.
set -eo pipefail

PROD_DOMAIN="expense.labnotes.org"

echo -e "\033[0;32m--- Step 1: Check (fmt, lint, types) ---\033[0m"
pnpm check

if [ "$1" = "--skip-tests" ]; then
  echo -e "\033[0;33m--- Step 2: Skipping tests ---\033[0m"
else
  echo -e "\033[0;32m--- Step 2: Run tests ---\033[0m"
  pnpm test
fi

echo -e "\033[0;32m--- Step 3: Sync production database schema ---\033[0m"
./scripts/migrate-prod
# migrate-prod pulls prod env to .env.prod.pull; re-source it so the deploy
# and smoke steps below see SMOKE_TEST_SECRET / VERCEL_PROTECTION_BYPASS.
set -a
source .env.prod.pull
set +a

echo -e "\033[0;32m--- Step 4: Deploy to Vercel (production) ---\033[0m"
DEPLOY_OUTPUT=$(npx -y vercel@latest deploy --prod --yes 2>&1)
echo "$DEPLOY_OUTPUT"
DEPLOY_URL=$(echo "$DEPLOY_OUTPUT" | grep -oE 'https://[a-zA-Z0-9.-]+\.vercel\.app' | head -1 || true)
if [ -z "$DEPLOY_URL" ]; then
  echo -e "\033[0;33mCould not determine the deployment URL — falling back to the production alias.\033[0m"
  DEPLOY_URL="https://${PROD_DOMAIN}"
fi

echo -e "\033[0;32m--- Step 4b: Post-deploy smoke check (PDF + OCR + MCP) ---\033[0m"
if [ -z "$SMOKE_TEST_SECRET" ]; then
  echo -e "\033[0;33mSMOKE_TEST_SECRET is not set in the Vercel environment — skipping the PDF/OCR/MCP smoke check.\033[0m"
  echo "Add it in the Vercel dashboard (Settings → Environment Variables, production):"
  echo "it gates GET /api/smoke via the x-smoke-secret header, which this script curls after each deploy."
else
  if [ -z "$VERCEL_PROTECTION_BYPASS" ]; then
    echo -e "\033[0;33mVERCEL_PROTECTION_BYPASS is not set — the smoke check cannot reach the protected deployment URL; skipping.\033[0m"
    echo "Create it in Vercel (Settings → Security → Protection Bypass for Automation) and add it as a production env var."
  else
    # Shared with the CI workflow's pdf-ocr-smoke job — see scripts/smoke-check.
    ./scripts/smoke-check "$DEPLOY_URL"
  fi
fi

echo -e "\033[0;32m--- Step 5: Open production site ---\033[0m"
open "https://${PROD_DOMAIN}"

echo -e "\033[0;34m--- Deployed ---\033[0m"
