#!/usr/bin/env bash
# Deploy expense to production:
#   1. sync the production database schema (Supabase; prod env pulled from Vercel)
#   2. deploy with the Vercel CLI
#   3. open the production site
#
# Prod secrets come from `vercel env pull` (the Infisical link is stale —
# see AGENTS.md; .env.prod.pull is gitignored). Use DATABASE_URL_UNPOOLED for
# schema DDL — the pooled URL is for runtime queries. The preflight script is
# a no-op on an already-baselined database (it only matters if the DB is a
# restored pre-account dump), and `migrate resolve` re-records the baseline.
set -eo pipefail

PROD_DOMAIN="expense.labnotes.org"

echo -e "\033[0;32m--- Step 1: Check (fmt, lint, types) ---\033[0m"
pnpm check

if [ "$1" = "--skip-tests" ]; then
  echo -e "\033[0;33m--- Step 2: Skipping tests ---\033[0m"
else
  echo -e "\033[0;32m--- Step 2: Run tests ---\033[0m"
  pnpm test
fi

echo -e "\033[0;32m--- Step 3: Pull production env (Vercel) ---\033[0m"
npx -y vercel@latest env pull --environment=production --yes .env.prod.pull
set -a
source .env.prod.pull
set +a
export DATABASE_URL="$DATABASE_URL_UNPOOLED"

echo -e "\033[0;32m--- Step 4: Sync production database schema ---\033[0m"
node scripts/preflight-prod.mjs > /tmp/preflight-prod.sql
psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f /tmp/preflight-prod.sql
rm -f /tmp/preflight-prod.sql

# Money columns: TEXT → NUMERIC(10,2) nullable, preserving data. Prisma's own
# diff for String → Decimal? is DROP COLUMN + ADD COLUMN (data loss), so the
# conversion runs explicitly before db push. Guarded on the column still being
# TEXT — idempotent on re-runs.
echo -e "\033[0;33m--- Step 4b: Convert money columns TEXT → NUMERIC(10,2) ---\033[0m"
psql "$DATABASE_URL" -v ON_ERROR_STOP=1 <<'SQL'
DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'expenses' AND column_name = 'amount'
      AND data_type = 'text'
  ) THEN
    ALTER TABLE "expenses"
      ALTER COLUMN "amount" DROP NOT NULL,
      ALTER COLUMN "amount" SET DATA TYPE DECIMAL(10,2)
        USING CASE WHEN "amount" = '' THEN NULL ELSE "amount"::decimal(10,2) END,
      ALTER COLUMN "distanceMiles" DROP NOT NULL,
      ALTER COLUMN "distanceMiles" SET DATA TYPE DECIMAL(10,2)
        USING CASE WHEN "distanceMiles" = '' THEN NULL ELSE "distanceMiles"::decimal(10,2) END;
  END IF;
END $$;
DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'mileage' AND column_name = 'distanceMiles'
      AND data_type = 'text'
  ) THEN
    ALTER TABLE "mileage"
      ALTER COLUMN "distanceMiles" DROP NOT NULL,
      ALTER COLUMN "distanceMiles" SET DATA TYPE DECIMAL(10,2)
        USING CASE WHEN "distanceMiles" = '' THEN NULL ELSE "distanceMiles"::decimal(10,2) END;
  END IF;
END $$;
SQL

# Login identity: users.username → users.email (rename). Prisma's diff for a
# String → String rename is DROP COLUMN + ADD COLUMN NOT NULL, which fails on
# a non-empty users table — so the rename runs explicitly before db push,
# mirroring the money-column conversion above. Guarded on the column still
# being named "username" (idempotent on re-runs). The app's initStore then
# backfills the bootstrap user's email from APP_EMAIL (see database.ts).
echo -e "\033[0;33m--- Step 4c: Rename users.username → users.email ---\033[0m"
psql "$DATABASE_URL" -v ON_ERROR_STOP=1 <<'SQL'
DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'users' AND column_name = 'username'
  ) THEN
    ALTER TABLE "users" RENAME COLUMN "username" TO "email";
    ALTER INDEX IF EXISTS "users_username_key" RENAME TO "users_email_key";
  END IF;
END $$;
SQL

pnpm prisma db push --accept-data-loss
# Record the baseline migrations so future `prisma migrate deploy` has
# history. Errors when already recorded (P3008) are expected on re-runs.
pnpm prisma migrate resolve --applied 0_init || true
pnpm prisma migrate resolve --applied 20260731130000_image_blob_account_scope || true
pnpm prisma migrate resolve --applied 20260731195449_add_inbound_emails || true
pnpm prisma migrate resolve --applied 20260731202612_inbound_senders || true
pnpm prisma migrate resolve --applied 20260802120000_amounts_as_numeric || true
pnpm prisma migrate resolve --applied 20260802120544_drop_user_name || true
pnpm prisma migrate resolve --applied 20260803131818_username_to_email || true

echo -e "\033[0;32m--- Step 5: Deploy to Vercel (production) ---\033[0m"
DEPLOY_OUTPUT=$(npx -y vercel@latest deploy --prod --yes 2>&1)
echo "$DEPLOY_OUTPUT"
DEPLOY_URL=$(echo "$DEPLOY_OUTPUT" | grep -oE 'https://[a-zA-Z0-9.-]+\.vercel\.app' | head -1 || true)
if [ -z "$DEPLOY_URL" ]; then
  echo -e "\033[0;33mCould not determine the deployment URL — falling back to the production alias.\033[0m"
  DEPLOY_URL="https://${PROD_DOMAIN}"
fi

echo -e "\033[0;32m--- Step 5b: Post-deploy smoke check (PDF + OCR) ---\033[0m"
if [ -z "$SMOKE_TEST_SECRET" ]; then
  echo -e "\033[0;33mSMOKE_TEST_SECRET is not set in the Vercel environment — skipping the PDF/OCR smoke check.\033[0m"
  echo "Add it in the Vercel dashboard (Settings → Environment Variables, production):"
  echo "it gates GET /api/smoke via the x-smoke-secret header, which this script curls after each deploy."
else
  if [ -z "$VERCEL_PROTECTION_BYPASS" ]; then
    echo -e "\033[0;33mVERCEL_PROTECTION_BYPASS is not set — the smoke check cannot reach the protected deployment URL; skipping.\033[0m"
    echo "Create it in Vercel (Settings → Security → Protection Bypass for Automation) and add it as a production env var."
  else
    RESPONSE=$(curl -sS --fail --retry 3 --retry-delay 5 --retry-connrefused --max-time 120 \
      -H "x-vercel-protection-bypass: ${VERCEL_PROTECTION_BYPASS}" \
      -H "x-smoke-secret: ${SMOKE_TEST_SECRET}" "${DEPLOY_URL}/api/smoke") \
      || {
        echo -e "\033[0;31mSmoke check failed (network/HTTP). Check ${DEPLOY_URL}/api/smoke manually.\033[0m"
        exit 1
      }
    echo "$RESPONSE" | node -e '
      let body = "";
      process.stdin.on("data", (c) => (body += c));
      process.stdin.on("end", () => {
        const r = JSON.parse(body);
        if (r.ok !== true) {
          console.error("Smoke check failed:", r.error ?? JSON.stringify(r));
          process.exit(1);
        }
        console.log("PDF + OCR OK —", r.pdfText, "| OCR:", r.ocrText, "(" + r.ms + "ms)");
      });
    ' || {
      echo -e "\033[0;31mSmoke check failed: PDF/OCR pipeline did not pass on ${DEPLOY_URL}.\033[0m"
      exit 1
    }
  fi
fi

echo -e "\033[0;32m--- Step 6: Open production site ---\033[0m"
open "https://${PROD_DOMAIN}"

echo -e "\033[0;34m--- Deployed ---\033[0m"
