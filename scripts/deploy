#!/usr/bin/env bash
# Deploy expensify.
#
# NOTE: production currently runs on Vercel (git push to main auto-deploys)
# with a Neon Postgres database. The Coolify/GHCR steps below mirror the
# Rentail flow and are kept for a future move to self-hosted infra — the
# database step applies either way.
#
# Schema: on a pre-account database, `scripts/preflight-prod.mjs` first adds
# accountId columns (defaulting to a fresh bootstrap account) and creates the
# accounts/users tables — `prisma db push` cannot add NOT NULL columns to
# non-empty tables and cannot DROP INDEX constraint-backed uniques, so it
# would otherwise refuse. Then `db push` syncs the rest, and `migrate resolve`
# records the baseline so future `prisma migrate deploy` runs have history.
# On an already-baselined database, preflight is a no-op.
set -eo pipefail

IMAGE="ghcr.io/assaf/expensify:latest"

echo -e "\033[0;32m--- Step 1: Check (fmt, lint, types) ---\033[0m"
pnpm check

if [ "$1" = "--skip-tests" ]; then
  echo -e "\033[0;33m--- Step 2: Skipping tests ---\033[0m"
else
  echo -e "\033[0;32m--- Step 2: Run tests ---\033[0m"
  pnpm test
fi

echo -e "\033[0;32m--- Step 3: Sync production schema ---\033[0m"
infisical --env prod run -- node scripts/preflight-prod.mjs > /tmp/preflight-prod.sql
infisical --env prod run -- psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f /tmp/preflight-prod.sql
rm -f /tmp/preflight-prod.sql
infisical --env prod run -- pnpm prisma db push --accept-data-loss
infisical --env prod run -- pnpm prisma migrate resolve --applied 0_init
infisical --env prod run -- pnpm prisma migrate resolve --applied 20260731130000_image_blob_account_scope

echo -e "\033[0;32m--- Step 4: Build and push image ---\033[0m"
echo "$(infisical secrets get GHCR_TOKEN --env dev --plain)" | docker login ghcr.io -u assaf --password-stdin
docker build -t "${IMAGE}" .
docker push "${IMAGE}"

echo -e "\033[0;32m--- Step 5: Deploy to Coolify ---\033[0m"
infisical export --env prod --format=dotenv > .env
infisical --env prod run -- coolify-ghcr-deploy \
  --app-name "expensify" \
  --coolify-url "https://coolify.labnotes.org" \
  --env-file ".env" \
  --image "${IMAGE}" \
  --healthcheck-timeout 60

rm -f .env

echo -e "\033[0;34m--- Deployed ---\033[0m"
