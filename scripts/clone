#!/usr/bin/env bash
# Clone the Vercel production database (Supabase) to the local development database.
#
# Prod env comes from `vercel env pull` (see AGENTS.md); DATABASE_URL_UNPOOLED
# is used for the dump; the pooled URL is for runtime queries. The backup is
# written to prisma/backup.sql (gitignored, overwritten on every run).
#
# Images live in Postgres (image_blobs, IMAGE_BACKEND=pg in prod and dev), so
# the clone carries the receipt images with it, since there is no external storage to sync.
# After the clone, the local app logs in with the same credentials as prod
# (APP_EMAIL/APP_PASSWORD).
#
# The restore is followed by `prisma db push` so the local schema always ends
# at the repo's latest (the prod dump lags whenever new tables/columns haven't
# been deployed yet), and the migration history is reconciled by marking the
# dump's missing migrations as applied; prod applies schema with db push,
# which never records migrations, so a raw dump would otherwise report them
# as pending and the next `prisma migrate dev` would try to re-apply them.
#
# Usage: ./scripts/clone
# Env:   LOCAL_DB_URL overrides the local database (default: .env DATABASE_URL
#        or postgres://assaf@localhost/expense_dev)
set -eo pipefail

# Local database: explicit override → .env → default.
LOCAL_DB_URL="${LOCAL_DB_URL:-$(
  grep '^DATABASE_URL=' .env 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"'
)}"
LOCAL_DB_URL="${LOCAL_DB_URL:-postgres://assaf@localhost/expense_dev}"
BACKUP_FILE="prisma/backup.sql"

# 1. Pull production env from Vercel when .env.prod is missing.
if [ ! -f .env.prod ]; then
  echo -e "\033[0;32mPulling production env from Vercel …\033[0m"
  vercel env pull --environment=production --yes .env.prod
fi
set -a
source .env.prod
set +a
PROD_DB_URL="${DATABASE_URL_UNPOOLED:-${DATABASE_URL:-}}"
if [ -z "$PROD_DB_URL" ]; then
  echo -e "\033[0;31mNo DATABASE_URL_UNPOOLED in .env.prod — pull it with:\033[0m"
  echo "  vercel env pull --environment=production --yes .env.prod"
  exit 1
fi

# 2. Make sure the local database exists.
if ! psql "$LOCAL_DB_URL" -c "select 1" >/dev/null 2>&1; then
  echo -e "\033[0;32mCreating local database …\033[0m"
  createdb "$LOCAL_DB_URL"
fi

# 3. Dump production (plain dump; the local schema is dropped and recreated
#    before restore, so the dump must not carry --clean's drop statements).
#    The pooler URL carries sslmode=no-verify, a pg/Prisma-only value; libpq
#    (pg_dump/psql) rejects it. Translate to sslmode=require: encrypt-only,
#    no CA check, same intent (verify-ca/full would fail on the pooler's
#    private CA).
echo -e "\033[0;32mDumping production database → $BACKUP_FILE …\033[0m"
pg_dump "${PROD_DB_URL/sslmode=no-verify/sslmode=require}" \
  --file "$BACKUP_FILE" \
  --schema public \
  --no-owner \
  --no-privileges

# 4. Drop the local schema (the dump recreates it), then restore.
echo -e "\033[0;32mRestoring into $LOCAL_DB_URL …\033[0m"
psql "$LOCAL_DB_URL" -v ON_ERROR_STOP=1 -c "DROP SCHEMA public CASCADE;"
psql "$LOCAL_DB_URL" -v ON_ERROR_STOP=1 -f "$BACKUP_FILE" >/dev/null

# 5. Apply the latest contract to the local database. The prod dump reflects
#    prod's schema, which lags the repo whenever new tables/columns haven't
#    been deployed yet. db update is additive and non-destructive, and
#    advances the contract marker. DATABASE_URL is overridden because
#    sourcing .env.prod above left it pointing at prod. Never push schema to
#    prod from here.
echo -e "\033[0;32mApplying the latest schema to the local database …\033[0m"
DATABASE_URL="$LOCAL_DB_URL" pnpm db:push

echo -e "\033[0;32mClone complete.\033[0m"
echo "  - Local login uses prod credentials (APP_EMAIL / APP_PASSWORD in .env)."
echo "  - Receipt images are in image_blobs and come with the clone."
echo "  - Local schema synced to the latest contract (prisma db update)."

# 7. Open the local site (dev server must be running: pnpm dev).
open "https://expense.localhost"
