#!/usr/bin/env bash

set -eo pipefail

echo -e "\033[0;32m--- Verify Prisma ORM pins match the CLI ---\033[0m"
node --input-type=module -e '
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { join } from "node:path";
import { pathToFileURL } from "node:url";
const pkg = JSON.parse(readFileSync("package.json", "utf8"));
const req = createRequire(pathToFileURL(join(process.cwd(), "package.json")).href);
const cli = JSON.parse(
  readFileSync(req.resolve("prisma/package.json"), "utf8"),
);
// The CLI validates the packs the project orm package contributes with its own
// bundled @prisma/orm-toolchain, so the two must be the same rc. A newer orm
// package renamed the pslBlock descriptor field (parameters -> spec) and the
// CLI rejects it as CONTRACT.PACK_CONTRIBUTION_INVALID at "enum".
const expected = cli.dependencies["@prisma/orm-toolchain"];
const declared = ["@prisma/orm-family-sql", "@prisma/orm-postgres"];
const mismatched = declared.filter((name) => pkg.dependencies[name] !== expected);
if (mismatched.length > 0) {
  console.error(
    `Prisma ORM packages must be pinned to ${expected} (what prisma ${cli.version} bundles), but:`,
  );
  for (const name of mismatched) console.error(`  ${name}: ${pkg.dependencies[name]}`);
  console.error(
    "Pin them exactly (no range) or move the CLI to a release bundling the same orm rc.",
  );
  process.exit(1);
}
console.log(`pass: prisma orm packages pinned to ${expected}`)
'
echo -e "\033[0;32m--- Emit Prisma contract ---\033[0m"
prisma contract emit

echo -e "\033[0;32m--- Build the merchant coverage table ---\033[0m"
tsx scripts/build-warranty-policies.ts

echo -e "\033[0;32m--- Generate types for route modules ---\033[0m"
react-router typegen

echo -e "\033[0;32m--- Run format, lint, and type checks ---\033[0m"
vp check

echo -e "\033[0;32m--- Run dark-mode variant check ---\033[0m"
node scripts/check-dark-mode.mjs

echo -e "\033[0;32m--- Run secretlint ---\033[0m"
secretlint "**/*"

echo -e "\033[0;32m--- Verify tesseract.js patch is applied ---\033[0m"
node --input-type=module -e '
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { join, dirname } from "node:path";
import { pathToFileURL } from "node:url";
const req = createRequire(pathToFileURL(join(process.cwd(), "package.json")).href);
const worker = req.resolve("tesseract.js/src/worker-script/node/index.js");
const getCore = readFileSync(join(dirname(worker), "getCore.js"), "utf8");
if (!getCore.includes(".wasm.js")) {
  console.error(
    "tesseract.js patch is not applied — embedded wasm core variants are missing.",
  );
  console.error(
    "Regenerate it: pnpm patch tesseract.js@<version>, edit src/worker-script/node/getCore.js",
  );
  console.error(
    "to require the .wasm.js variants, then pnpm patch-commit. See patches/tesseract.js@7.0.0.patch.",
  );
  process.exit(1);
}
console.log("pass: tesseract.js patch applied (embedded wasm core)")
'
echo -e "\033[0;32m--- Run knip ---\033[0m"
knip
