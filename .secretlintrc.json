{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Resend webhook secret (whsec_)",
            "patterns": ["/whsec_[A-Za-z0-9+/=_-]{16,}/"]
          },
          {
            "name": "session cookie secret assignment",
            "patterns": [
              "/SESSION_SECRET\\s*[:=]\\s*(?<secret>[A-Za-z0-9_-]{16,})/"
            ],
            "allows": ["/ci-only-session-secret/"]
          },
          {
            "name": "Resend API key (re_)",
            "patterns": ["/re_[A-Za-z0-9_]{20,}/"]
          },
          {
            "name": "Fastmail API token (fmu1-)",
            "patterns": ["/fmu1-[A-Za-z0-9-]{20,}/"]
          }
        ]
      }
    }
  ]
}
