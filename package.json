{
  "name": "expense",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build --force",
    "build:policies": "tsx scripts/build-warranty-policies.ts",
    "build:prisma": "prisma contract emit",
    "check": "./scripts/check",
    "clean": "rm -rf node_modules/.vite .react-router build",
    "cloc": "cloc --exclude-dir=node_modules,dist,build,coverage .",
    "clone": "./scripts/clone",
    "db:push": "prisma db update",
    "demo": "react-router build --force && DEMO=1 vp test run test/screenshot.test.ts -t \"drop-a-receipt\"",
    "deploy": "./scripts/deploy",
    "dev": "tsx scripts/build-warranty-policies.ts && portless run -- react-router dev",
    "drain:email": "tsx scripts/drain-email-connection",
    "figures": "tsx scripts/annotate-figures.ts",
    "infer:rules": "tsx scripts/infer-email-rules",
    "logo": "tsx scripts/logo.ts",
    "prebuild": "prisma contract emit && tsx scripts/build-warranty-policies.ts",
    "prepare": "vp config",
    "preview:confirmation": "NODE_OPTIONS=--import=./scripts/lib/vite-assets.mjs tsx scripts/preview-confirmation",
    "screenshot": "SCREENSHOT=1 vp test run test/screenshot.test.ts",
    "screenshots:review": "tsx scripts/screenshots.ts",
    "secretlint": "secretlint \"**/*\"",
    "setup:push": "tsx scripts/setup-push.ts",
    "start": "NODE_ENV=production react-router-serve ./build/server/index.js",
    "test": "pnpm check && react-router build --force && vp test run",
    "test:changed": "vp test run --changed ${1:-HEAD}",
    "test:db:push": "bash scripts/reset-test-db",
    "test:ocr": "RUN_OCR_TESTS=1 vpr test run test/pdf-ocr.test.ts test/receipt-ocr.test.ts",
    "test:related": "vp test related --run",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@expense/pdfkit-standard-fonts": "file:vendor/pdfkit-standard-fonts",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@napi-rs/canvas": "^1.0.10",
    "@prisma/orm-family-sql": "8.0.0-rc.13",
    "@prisma/orm-postgres": "8.0.0-rc.13",
    "@react-router/dev": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^11.4.0",
    "@sentry/react-router": "^11.4.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "csv-stringify": "^6.9.0",
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.3",
    "http_ece": "^1.2.1",
    "isbot": "^5.2.2",
    "kbar": "^1.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "postal-mime": "^4.0.4",
    "puppeteer-core": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@prisma/cli-engine": "0.6.2",
    "@secretlint/secretlint-rule-pattern": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.2",
    "knip": "^6.39.0",
    "looks-same": "^10.0.1",
    "playwright": "^1.63.0",
    "prisma": "8.0.0-rc.19",
    "secretlint": "^13.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "portless": "expense"
}
