{
  "name": "expense",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build --force",
    "prebuild": "prisma contract emit",
    "check": "./scripts/check",
    "clean": "rm -rf node_modules/.vite .react-router build",
    "cloc": "cloc --exclude-dir=node_modules,dist,build,coverage .",
    "dev": "portless run -- react-router dev",
    "screenshot": "SCREENSHOT=1 vp test run test/screenshot.test.ts",
    "start": "NODE_ENV=production react-router-serve ./build/server/index.js",
    "test": "react-router build --force && vp test run",
    "test:unit": "vitest run --project unit",
    "prepare": "vp config",
    "build:prisma": "prisma contract emit",
    "setup:push": "tsx scripts/setup-push.ts",
    "infer:rules": "tsx scripts/infer-email-rules",
    "drain:email": "tsx scripts/drain-email-connection",
    "test:ocr": "RUN_OCR_TESTS=1 vpr test run test/pdf-ocr.test.ts test/receipt-ocr.test.ts",
    "db:push": "prisma db update",
    "db:migrate": "prisma db migrate",
    "knip": "knip",
    "secretlint": "secretlint \"**/*\"",
    "test:db:push": "bash scripts/reset-test-db"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@napi-rs/canvas": "^1.0.8",
    "@prisma/orm-family-sql": "8.0.0-rc.7",
    "@prisma/orm-postgres": "8.0.0-rc.7",
    "@react-router/dev": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/profiling-node": "^10.71.0",
    "@sentry/react": "^10.71.0",
    "@sentry/react-router": "^10.71.0",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-stringify": "^6.8.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "http_ece": "^1.2.1",
    "isbot": "^5.2.1",
    "kbar": "^1.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.20.1",
    "pg": "8.22.0",
    "portless": "^0.15.6",
    "postal-mime": "^3.0.0",
    "puppeteer-core": "^25.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@prisma/cli-engine": "0.2.3",
    "@secretlint/secretlint-rule-pattern": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.3.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "knip": "^6.32.2",
    "playwright": "^1.62.1",
    "prisma": "8.0.0-rc.10",
    "secretlint": "^13.0.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0",
  "knip": {
    "ignoreFiles": [
      "test/helpers/pinned-clock.mjs"
    ]
  },
  "portless": "expense"
}
