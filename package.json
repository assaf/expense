{
  "name": "expense",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build --force",
    "prebuild": "prisma generate",
    "check": "./scripts/check",
    "clean": "rm -rf node_modules/.vite .react-router build prisma/generated",
    "dev": "portless run -- react-router dev",
    "screenshot": "SCREENSHOT=1 vp test run test/screenshot.test.ts",
    "start": "react-router-serve ./build/server/index.js",
    "test": "react-router build --force && vp test run",
    "prepare": "vp config",
    "build:prisma": "prisma generate",
    "test:ocr": "RUN_OCR_TESTS=1 vp test run test/pdf-ocr.test.ts",
    "compress:images": "node scripts/compress-images.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "knip": "knip",
    "test:db:push": "prisma db push --force-reset --accept-data-loss"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@napi-rs/canvas": "^1.0.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-router/dev": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-stringify": "^6.8.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "isbot": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1",
    "puppeteer-core": "^25.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "knip": "^6.31.0",
    "playwright": "^1.62.1",
    "portless": "^0.15.5",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "portless": "expense"
}
