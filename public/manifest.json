{
  "name": "Expense",
  "short_name": "Expense",
  "description": "Personal expense tracking with receipts and mileage.",
  "start_url": "/expenses",
  "display": "standalone",
  "share_target": {
    "action": "/api/share-receipt",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  },
  "background_color": "#f9fafb",
  "theme_color": "#0d9488",
  "icons": [
    {
      "src": "/logo-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/logo-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
